{
  "type": "minecraft:tree",
  "config": {
    "below_trunk_provider": {
      "type": "minecraft:rule_based_state_provider",
      "rules": [
        {
          "if_true": {
            "type": "minecraft:not",
            "predicate": {
              "type": "minecraft:any_of",
              "predicates": [
                { "type": "minecraft:matching_block_tag", "tag": "minecraft:cannot_replace_below_tree_trunk" },
                { "type": "minecraft:matching_blocks", "blocks": ["minecraft:sand", "minecraft:red_sand"] }
              ]
            }
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": { "Name": "minecraft:dirt" }
          }
        }
      ]
    },
    "decorators": [],
    "foliage_placer": {
      "type": "suprememc:palm_foliage_placer",
      "radius": 1,
      "offset": 0,
      "frond_count": 7,
      "frond_length": 5
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "suprememc:palm_leaves",
        "Properties": {
          "distance": "7",
          "persistent": "true",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": true,
    "minimum_size": { "type": "minecraft:two_layers_feature_size" },
    "trunk_placer": {
      "type": "suprememc:palm_trunk_placer",
      "base_height": 10,
      "height_rand_a": 2,
      "height_rand_b": 1,
      "bend_start_height": 3,
      "bend_interval": {
        "type": "minecraft:uniform",
        "min_inclusive": 2,
        "max_inclusive": 3
      },
      "max_lean": 4
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "suprememc:palm_log",
        "Properties": { "axis": "y" }
      }
    }
  }
}